types roe_window_types {

    type roe_domains_window = default_popup {
        size = { 1120 700 }
        name = "roe_domains_window"
        visible = "[Or(GetVariableSystem.HasValue('roe_open_window', 'roe_domains_window'), GetVariableSystem.HasValue('roe_alert_action', Localize('domains_window_action')))]"
        datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"

        alpha = 0

        blockoverride "minimize" {
            minimize_button_large = {
                onclick = "[GetVariableSystem.Clear('roe_open_window')]"
                onclick = "[GetVariableSystem.Clear('roe_alert_action')]"
                onclick = "[GetVariableSystem.Clear('show_gryphon_constellation')]"
                onclick = "[GetVariableSystem.Clear('show_justice_constellation')]"
                onclick = "[GetVariableSystem.Clear('show_sphinx_constellation')]"
                onclick = "[GetVariableSystem.Clear('show_phoenix_constellation')]"
                onclick = "[GetVariableSystem.Clear('show_unicorn_constellation')]"
                onclick = "[GetVariableSystem.Clear('show_fey_constellation')]"
                onclick = "[GetVariableSystem.Clear('show_golem_constellation')]"
                onclick = "[GetVariableSystem.Clear('show_djinn_constellation')]"
                onclick = "[GetVariableSystem.Clear('show_siren_constellation')]"
                onclick = "[GetVariableSystem.Clear('show_kraken_constellation')]"
                onclick = "[GetVariableSystem.Clear('show_fiend_constellation')]"
                onclick = "[GetVariableSystem.Clear('show_dragon_constellation')]"
                onclick = "[GetVariableSystem.Clear('show_angel_constellation')]"
                parentanchor = center
                shortcut = "close_window"
            }
        }
        blockoverride "header_close_button_visibility" {
            visible = yes
        }

        blockoverride "window_header_name" {
            text = "domains_window_title"
            default_format = "#bold"
            using = header_font_fancy
			fontsize = 32
        }
        blockoverride "content" {}

        blockoverride "second_text" {
            visible = no
        }

        blockoverride "goto_visibility" {
            visible = no
        }

        blockoverride "goto_properties" {
            onclick = "[Country.GetCapital.ZoomToCapital]"
            tooltip = "ROE_ZOOM_TO_CAPITAL_STATE"
            enabled = "[Not(Country.GetCapital.IsZoomingToCapital)]"
        }

        state = {
            trigger_on_create = yes
            name = 1
            duration = 0.3
            using = Animation_Curve_EaseOut
            alpha = 1
            using = Snapshot_Mute_World_100
            using = Snapshot_Mute_Vfx_War_100
            start_sound = {
                soundeffect = "event:/SFX/UI/Alerts/event_appear"
            }
        }

        ### SETTING SIZE OF WINDOW
        flowcontainer = {


            resizeparent = yes
            margin = { 25 0 }
            margin_bottom = 15
            margin_top = -10

            ### VIDEO/IMAGE + TEXT/OPTIONS
            container = {
                container = {
                    minimumsize = { 1120 -1 }
                    position = { 0 90 }

                    flowcontainer = {
                        direction = horizontal
                        spacing = 0
                        widget = {
                        background = {
                            using = entry_bg
                            margin = { -16 -21 }
                        }
                            size = { 560 600 }
                            widget = {
                                size = { 100% 100% }

                                background = {
                                    texture = "gfx/interface/backgrounds/tutorial_bg.dds"
                                    spriteType = Corneredtiled
                                    spriteborder = { 20 20 }
                                    alpha = 0.94

                                    modify_texture = {
                                        texture = "gfx/interface/illustrations/modded_ui/constellation_background.dds"
                                        spriteType = Corneredstretched
                                        spriteborder = { 0 0 }
                                        blend_mode = overlay
                                        alpha = 0.7
                                    }
                                    margin = { -15 -20 }
                                }

							back_button_large = {
								position = { 30 35 }
								    onclick = "[GetVariableSystem.Clear('show_gryphon_constellation')]"
                                    onclick = "[GetVariableSystem.Clear('show_justice_constellation')]"
                                    onclick = "[GetVariableSystem.Clear('show_sphinx_constellation')]"
                                    onclick = "[GetVariableSystem.Clear('show_phoenix_constellation')]"
                                    onclick = "[GetVariableSystem.Clear('show_unicorn_constellation')]"
                                    onclick = "[GetVariableSystem.Clear('show_fey_constellation')]"
                                    onclick = "[GetVariableSystem.Clear('show_golem_constellation')]"
                                    onclick = "[GetVariableSystem.Clear('show_djinn_constellation')]"
                                    onclick = "[GetVariableSystem.Clear('show_siren_constellation')]"
                                    onclick = "[GetVariableSystem.Clear('show_kraken_constellation')]"
                                    onclick = "[GetVariableSystem.Clear('show_fiend_constellation')]"
                                    onclick = "[GetVariableSystem.Clear('show_angel_constellation')]"
                                    onclick = "[GetVariableSystem.Clear('hide_domain_tutorial')]"
                                    onclick = "[GetVariableSystem.Clear('show_dragon_constellation')]"
                                    visible = "[GetVariableSystem.Exists('hide_domain_tutorial')]"
							}

                                flowcontainer = {
