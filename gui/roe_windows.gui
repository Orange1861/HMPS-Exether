    type roe_domain_button = widget {
        parentanchor = vcenter|hcenter
        size = { 60 60 }
        
        block "button_tooltip" {
            tooltip = concept_gryphon_desc
        }
        using = selected_sidepanel_animation_small
        blockoverride "selected_visibility" {
            block "selected_visibility" {
                visible = no
            }
        }



         block "line" {
        }

        textbox = {
            position = { 0 47.5 }
            name = "description"
            multiline = yes
            autoresize = yes
            minimumsize = { 0 -1 }
            maximumsize = { 420 -1 }
            parentanchor = top|hcenter
            align = hcenter|nobaseline
                        background = {
				using = blurry_dark_background

			}
			background = {
				using = paper_bg
                alpha = 0.95
				margin = { -10 -5 }
			}

            block "text" {
                text = "domain_name"
            }
            margin = { 20 10 }
        }

        
        sidepanel_button_small = {
            position = { 0 0 }
            size = { 60 60 }


            blockoverride "icon" {
                textbox = {
                    size = { 60 60 }
                    scale = 1.8
                    align = vcenter|hcenter
                    parentanchor = vcenter|hcenter
                    block "button_text" {
                        raw_text = "@innovation!"
                    }
                }
            }
            block "button_enabled" {
                enabled = no
            }
            onclick = "[GetVariableSystem.Clear('show_gryphon_constellation')]"
            onclick = "[GetVariableSystem.Clear('show_justice_constellation')]"
            onclick = "[GetVariableSystem.Clear('show_sphinx_constellation')]"
            onclick = "[GetVariableSystem.Clear('show_phoenix_constellation')]"
            onclick = "[GetVariableSystem.Clear('show_unicorn_constellation')]"
            onclick = "[GetVariableSystem.Clear('show_fey_constellation')]"
            onclick = "[GetVariableSystem.Clear('show_golem_constellation')]"
            onclick = "[GetVariableSystem.Clear('show_djinn_constellation')]"
            onclick = "[GetVariableSystem.Clear('show_siren_constellation')]"
            onclick = "[GetVariableSystem.Clear('show_kraken_constellation')]"
            onclick = "[GetVariableSystem.Clear('show_fiend_constellation')]"
            onclick = "[GetVariableSystem.Clear('show_angel_constellation')]"
            onclick = "[GetVariableSystem.Clear('show_dragon_constellation')]"
            onclick = "[GetVariableSystem.Set('hide_domain_tutorial', 'active')]"
            block "button_onclick" {}

            textbox = {
				parentanchor = right|top
				position = { -5 0 }
				autoresize = yes
                block "number_text" {
                    raw_text = "#bold [GetDataModelSize(GetPlayer.MakeScope.GetList('active_arcana_id_siren_list'))]#!"
                }
                block "number_visible" {
				    visible = "[GreaterThan_int32(GetDataModelSize(GetPlayer.MakeScope.GetList('active_arcana_id_all_list')), '(int32)0')]"
                }
				align = left|nobaseline
				using = fontsize_small
				background = {
					using = default_background
					margin = { 8 5 }
				}
			}
        }
    }

