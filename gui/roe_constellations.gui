            blockoverride "button_tooltip" {
                datacontext = "[GetScriptedGui('cast_arcana_id_angel_button_effect')]"
                tooltip = "rylmar_tooltip"
            }
            blockoverride "button_active_tooltip" {
                datacontext = "[GetScriptedGui('dispel_arcana_angel_button_effect')]"
                tooltip = "rylmar_tooltip"
            }
            blockoverride "button_enabled" {
                datacontext = "[GetScriptedGui('cast_arcana_id_angel_button_effect')]"
			    enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(AccessPlayer.MakeScope).AddScope('arcana_id_angel', MakeScopeValue('(CFixedPoint)4')).End)]"
            }
            blockoverride "button_active_enabled" {
                datacontext = "[GetScriptedGui('dispel_arcana_angel_button_effect')]"
			    enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(AccessPlayer.MakeScope).AddScope('arcana_id_angel', MakeScopeValue('(CFixedPoint)4')).End)]"
            }
            blockoverride "button_onclick" {
                datacontext = "[GetScriptedGui('cast_arcana_id_angel_button_effect')]"
                onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(AccessPlayer.MakeScope).AddScope('arcana_id_angel', MakeScopeValue('(CFixedPoint)4')).End)]"
            }
            blockoverride "button_active_onclick" {
                datacontext = "[GetScriptedGui('dispel_arcana_angel_button_effect')]"
                onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(AccessPlayer.MakeScope).AddScope('arcana_id_angel', MakeScopeValue('(CFixedPoint)4')).End)]"
            }
            blockoverride "hide_cast" {
                datacontext = "[GetScriptedGui('check_has_angel_modifier')]"
                visible = "[Not(ScriptedGui.IsValid(GuiScope.SetRoot(AccessPlayer.MakeScope).AddScope('arcana_id_angel', MakeScopeValue('(CFixedPoint)4')).End))]"
            }
            blockoverride "button_text" {
                raw_text = "@state!"
            }
            blockoverride "text" {
                text= "[concept_rylmar]"
            }
            blockoverride "highlight" {
                datacontext = "[GetScriptedGui('check_has_angel_modifier')]"
                visible = "[ScriptedGui.IsValid(GuiScope.SetRoot(AccessPlayer.MakeScope).AddScope('arcana_id_angel', MakeScopeValue('(CFixedPoint)4')).End)]"
            }

        }
    }   

}